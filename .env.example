# ── API Keys ──────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── Database (matches docker-compose.yml) ─────────────────
DB_HOST=localhost
DB_PORT=6024
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=rag_db

# ── Models ────────────────────────────────────────────────
EMBEDDING_MODEL=nomic-embed-text-v2-moe
AGENT_MODEL=openrouter/auto

# ── Server ────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
